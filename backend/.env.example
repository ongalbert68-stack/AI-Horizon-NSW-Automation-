# Copy to backend/.env. Must match the Postgres container started from the
# repo-root compose.yaml (see ../.env.example) when using it for local dev.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ai_horizon
POSTGRES_PASSWORD=ai_horizon
POSTGRES_DB=ai_horizon_nsw

# Origins allowed to call this API, comma-separated handled via JSON list
# in app/core/config.py defaults; override here as a JSON array if needed:
# CORS_ORIGINS=["http://localhost:3000"]

# Optional LLM reasoner. Get a free key at
# https://console.groq.com/keys — leave blank to run without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
